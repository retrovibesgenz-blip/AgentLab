# ============================================================
#  AgentLab — copy this file to ".env" and paste your key.
#  Default provider is Z.AI (GLM). Get a key:
#    https://z.ai/manage-apikey/apikey-list
# ============================================================
ZAI_API_KEY=PASTE_YOUR_ZAI_KEY_HERE

# --- optional (good defaults; leave alone unless you know why) ---
# glm-4.6v-flash reads screenshots (needed for screen control). The
# text-only glm-4.7-flash will 400 when VISION_ENABLED=true.
AGENT_MODEL=glm-4.6v-flash
VISION_ENABLED=true
# physical  = agent uses your REAL mouse + keyboard like a human; works in EVERY
#             app (browsers, Spotify, games). Shares your cursor while running.
# background = agent's own cursor via Win32 messages; can't drive Chromium/games.
INPUT_MODE=physical
# Clicking accuracy: USE_GRID overlays a coordinate ruler on the AI's screenshot.
# USE_UI_ELEMENTS reads every clickable control (accurate but adds ~1-2s/step).
USE_GRID=true
USE_UI_ELEMENTS=false
USE_LOCAL=false
# Multi-monitor: the engine auto-picks your PRIMARY screen. If the agent ever
# watches the wrong monitor, set MONITOR to 1, 2, ... to force one.
# MONITOR=1
WS_HOST=127.0.0.1
WS_PORT=8765
MAX_STEPS=40

# --- Voice chat (ElevenLabs) — talk to the agent and it talks back ---------
# Get a key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=PASTE_YOUR_ELEVENLABS_KEY_HERE
# Voice = "George" — a free-tier premade voice (works via API on free plans).
# NOTE: library/cloned voices require a PAID plan (they return 402 on free keys).
# Free-usable premade voices: George JBFqnCBsd6RMkjVDRZzb, Adam pNInz6obpgDQGcFmaJgB.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# --- Kaggle GPU backup (optional) — run your open vision model on Kaggle -------
# Selected in-app via "⚡ Kaggle GPU". Key: kaggle.com -> Settings -> Create New Token.
KAGGLE_USERNAME=PASTE_YOUR_KAGGLE_USERNAME
KAGGLE_KEY=PASTE_YOUR_KAGGLE_KEY
# Use a FAST, non-thinking vision model (thinking models feel stuck in a loop):
KAGGLE_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
KAGGLE_KERNEL_SLUG=
KAGGLE_LINK_DATASET=
# Already have a worker running? Paste its public URL to skip auto-start:
KAGGLE_ENDPOINT_URL=
KAGGLE_BOOT_TIMEOUT=900
HF_TOKEN=

# --- Ollama (local models) — install from ollama.com, keep it running ---------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2-vision
STEP_DELAY=1.2
MOVE_STEPS=24
FAILSAFE=true

# ------------------------------------------------------------------
# Prefer a different provider? Any OpenAI-compatible API works.
# The engine reads keys in this order: ZAI_API_KEY, GEMINI_API_KEY,
# BYNARA_API_KEY — and base URLs as ZAI_BASE_URL / GEMINI_BASE_URL /
# BYNARA_BASE_URL. Set the matching *_BASE_URL + AGENT_MODEL to switch.
#   e.g. Gemini:  GEMINI_API_KEY=AIza...   AGENT_MODEL=gemini-2.5-flash
#        GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# No key at all? Set USE_LOCAL=true and load the WebGPU model in the app.
# ------------------------------------------------------------------
